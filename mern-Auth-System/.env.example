# Backend Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://username:***@cluster0.example.mongodb.net/dbname
JWT_SECRET=your_jwt_secret_here_change_this_to_a_strong_random_string
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_change_this_to_another_strong_random_string
NODEMAILER_EMAIL=your-email@example.com
NODEMAILER_PASS=your_email_password_or_app_password
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here_if_using_twilio
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here_if_using_twilio
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here_if_using_twilio
FRONTEND_URL=https://your-frontend.vercel.app